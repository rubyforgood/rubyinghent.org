---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ScheduleTabs from "../components/ScheduleTabs.jsx";
---

<Layout
  title="Ruby in Ghent 2027 - Schedule"
  description="The schedule for Ruby in Ghent, February 1-3, 2027. Location and registration details coming soon."
>
  <Header
    headerText="Schedule"
    description="Good code, good company, and time to enjoy both. We'll build together during the day and make room for getting to know each other along the way. We're planning evening activities like board games and karaoke, with plenty of chances to chat, laugh, and unwind."
  />
  <section class="schedule">
    <div class="container">
      <div class="body">
        <h1>Schedule</h1>
        <p>
          Here's a rough idea of the schedule for February 1-3, 2027. We'll
          balance focused project time with breaks, conversations, and
          socializing. Evening activities are optional, so join in or
          recharge at your own pace. More details will follow as we get
          closer to the event.
        </p>
        <ScheduleTabs client:load />
      </div>
    </div>
  </section>
</Layout>
