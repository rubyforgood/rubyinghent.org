---
import styles from "../../styles/modules/header.module.scss";

interface Props {
  headerText: string;
  description: string;
}

const { headerText, description } = Astro.props;
---

<header class={styles.header}>
  <img src="/img/banners/about.svg" alt="" />
  <div>
    <h1>{headerText}</h1>
    <p>{description}</p>
  </div>
</header>
